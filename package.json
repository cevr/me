{
  "name": "me",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#server-build": {
      "types": "./src/server/server-build.d.ts",
      "default": "./build/server/index.js"
    }
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test tests/",
    "gate": "concurrently -n type,style,build -c blue,yellow,cyan \"bun run typecheck\" \"bun run lint && bun run fmt\" \"bun run build\" && bun run test",
    "plan": "react-router build && alchemy plan alchemy.run.ts --stage prod",
    "deploy": "react-router build && alchemy deploy alchemy.run.ts --stage prod",
    "test:deploy": "react-router build && bun test ./tests/deploy.integration.ts",
    "prepare": "(test -d .git && lefthook install || true) && effect-tsgo patch"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.6",
    "@tailwindcss/vite": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.5",
    "gray-matter": "^4.0.3",
    "isbot": "5.2.2",
    "marked": "^17.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/tsgo": "0.53.1",
    "@react-router/dev": "8.4.0",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "alchemy": "2.0.0-beta.83",
    "concurrently": "10.0.6",
    "effect-bun-test": "0.4.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-effect": "0.28.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
